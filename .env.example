# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ── CLOUDINARY IMAGE STORAGE ──────────────────────────────────────────────────
# All product images are permanently stored on Cloudinary for:
# - Persistence across restarts, deployments, and git-sync
# - Automatic optimization and responsive delivery
# - High-performance CDN distribution

# CLOUDINARY_CLOUD_NAME: Your Cloudinary cloud name (found in dashboard)
CLOUDINARY_CLOUD_NAME="your_cloud_name"

# CLOUDINARY_API_KEY: Your Cloudinary API key (found in dashboard)
CLOUDINARY_API_KEY="your_api_key"

# CLOUDINARY_API_SECRET: Your Cloudinary API secret (keep secure, never commit)
CLOUDINARY_API_SECRET="your_api_secret"

# CLOUDINARY_UPLOAD_PRESET: Optional preset for unsigned uploads
# Default: royals_unsigned
CLOUDINARY_UPLOAD_PRESET="royals_unsigned"
