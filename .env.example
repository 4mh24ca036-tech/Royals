# ═══════════════════════════════════════════════════════════════════════════════
# ROYALS Luxury Couture — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your values for local development.
# NEVER commit .env to git — it is already in .gitignore.
#
# For Vercel production: add these as Environment Variables in the
# Vercel dashboard → Project Settings → Environment Variables.
#
# For the migration script: set SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY,
# then run:  npm run migrate
#
# ═══════════════════════════════════════════════════════════════════════════════


# ── SUPABASE (Persistent PostgreSQL database) ────────────────────────────────
#
# Found in: Supabase dashboard → Project Settings → API
#
# SUPABASE_URL              — your project URL, e.g. https://xxxx.supabase.co
# SUPABASE_ANON_KEY         — safe to expose to the browser (public)
# SUPABASE_SERVICE_ROLE_KEY — NEVER expose to the browser (bypasses RLS)
#
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"


# ── CLOUDINARY (Permanent image/media storage) ───────────────────────────────
#
# Found in: Cloudinary dashboard → Settings → API Keys
#
# CLOUDINARY_CLOUD_NAME  — your cloud name, e.g. "royals-couture"
# CLOUDINARY_API_KEY     — API key (safe in server code)
# CLOUDINARY_API_SECRET  — NEVER expose to the browser
# CLOUDINARY_UPLOAD_PRESET — unsigned preset name (default: royals_unsigned)
#
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
CLOUDINARY_UPLOAD_PRESET="royals_unsigned"


# ── AUTHENTICATION ────────────────────────────────────────────────────────────
#
# JWT_SECRET — secret used to sign customer and admin JWT tokens.
# Use a long random string (32+ characters). NEVER expose to the browser.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
JWT_SECRET="replace-with-a-long-random-secret-string-32-chars-minimum"


# ── APPLICATION ───────────────────────────────────────────────────────────────
#
# NODE_ENV — "development" locally, "production" on Vercel (set automatically)
# PORT     — local dev server port (default: 3031)
#
NODE_ENV="development"
PORT="3031"


# ── GEMINI AI (optional) ──────────────────────────────────────────────────────
#
GEMINI_API_KEY="your_gemini_api_key"


# ═══════════════════════════════════════════════════════════════════════════════
# VERCEL DEPLOYMENT CHECKLIST
# ═══════════════════════════════════════════════════════════════════════════════
#
# In Vercel dashboard → Project Settings → Environment Variables, add:
#
#   SUPABASE_URL                    (all environments)
#   SUPABASE_ANON_KEY               (all environments)
#   SUPABASE_SERVICE_ROLE_KEY       (all environments) ← mark Sensitive
#   CLOUDINARY_CLOUD_NAME           (all environments)
#   CLOUDINARY_API_KEY              (all environments)
#   CLOUDINARY_API_SECRET           (all environments) ← mark Sensitive
#   CLOUDINARY_UPLOAD_PRESET        (all environments)
#   JWT_SECRET                      (all environments) ← mark Sensitive
#
# DO NOT add PORT or NODE_ENV — Vercel manages these automatically.
#
# ═══════════════════════════════════════════════════════════════════════════════
