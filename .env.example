# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: Signing key for customer and admin session tokens.
# Required in production (minimum 32 characters); an ephemeral secret is used in development.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# ADMIN_INITIAL_PASSWORD: Password for the 'admin' account created the first time the
# database is seeded. Required in production. A random one is generated and logged in development.
ADMIN_INITIAL_PASSWORD=""

# ADMIN_EMAIL: Email address of the seeded admin account (defaults to admin@royals.com).
ADMIN_EMAIL=""

# DEMO_USER_PASSWORD: Password for the seeded demo customer account.
DEMO_USER_PASSWORD=""
